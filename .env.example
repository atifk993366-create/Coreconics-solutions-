# ── App ──
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
EMBED_JWT_SECRET=generate-a-long-random-string-min-32-chars
PLATFORM_ADMIN_SECRET=another-long-random-string      # optional: create approved partner labs by API (x-admin-secret header)
PLATFORM_ADMIN_EMAILS=you@coreconics.com               # comma separated Firebase emails who can approve registrations at /admin

# ── Firebase (Firestore + Auth) ──
# Server (Admin SDK): paste the whole service-account JSON as ONE line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Client (Web app config from Firebase console → Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Cloudinary (logo / signature uploads) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Calculation AI agent (own/independent AI) ──
# Default = Anthropic. For any OpenAI-compatible model set AI_PROVIDER=openai and AI_BASE_URL (Groq, OpenRouter, Ollama, vLLM...)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# AI_BASE_URL=
